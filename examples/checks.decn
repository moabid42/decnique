// Check blocks: each one asks the rule set a question and is answered pass / fail / unknown.
// Run in the shell:  rules load <rules/> examples/candidates.decn  →  account load examples/account.json
//                    →  checks load examples/checks.decn  →  ask check
//                    (or type a check block at the prompt, then ask check <id>)

// is every reachable + logged way of using this permission observed by some rule?
check key_creation_watched { type coverage permission iam.serviceAccountKeys.create }

// same question, but only for events that add an Owner binding (the payload that matters)
check owner_grant_watched {
  type coverage
  permission resourcemanager.projects.setIamPolicy
  event udm("target.resource.attribute.labels[ser_binding_deltas_action]") = "ADD"
    and udm("target.resource.attribute.labels[ser_binding_deltas_role]") = "roles/owner"
}

// is this technique caught however the attacker schedules it?
check escalation_caught { type candidate for escalate_project_iam }

// housekeeping over the whole rule set: rules that can never fire here / that add nothing
check no_dead_rules { type dead_rules }
check no_redundant_rules { type redundant_rules }

// is the payload step of the technique watched — as a success, and as a denied attempt?
check owner_grant_step_watched { type require_coverage for escalate_project_iam step act }
check owner_grant_attempt_watched { type attempt_coverage for escalate_project_iam step act }

// can ANY owner grant (except ones to service accounts) slip past every rule?
check owner_grants_are_a_boundary {
  type boundary
  permission resourcemanager.projects.setIamPolicy
  event udm("target.resource.attribute.labels[ser_binding_deltas_action]") = "ADD"
    and udm("target.resource.attribute.labels[ser_binding_deltas_role]") = "roles/owner"
  allowed udm("target.resource.attribute.labels[ser_binding_deltas_member]") startswith "serviceAccount:"
  mode observed
}

// can an anonymous principal use what it was granted on a project without being seen?
check nothing_public_unseen { type public_access resource like "projects/*" }
